<Page x:Class="OnlineShopPR.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OnlineShopPR.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid>
        <TabControl >
            <TabItem Header="ВХОД" FontSize="20">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">


                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Логин" Margin="0 0 10 0" FontSize="18"/>
                            <TextBox x:Name="TxtBoxLogLogin" Width="150" FontSize="18"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                            <TextBlock Text="Пароль" Margin="0 0 10 0" FontSize="18"/>
                            <PasswordBox x:Name="TxtBoxLogPassword" Width="150" FontSize="18"/>
                        </StackPanel>

                        <Button x:Name="BtnLogin" Content="Войти" Width="100" FontSize="20" Margin="0 10 0 0" HorizontalAlignment="Center" Click="BtnLogin_Click"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="РЕГИСТРАЦИЯ" FontSize="20">

                <StackPanel HorizontalAlignment="Center">
                    

                    <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
                        <TextBlock Text="Логин" Margin="0 0 10 0" FontSize="18"/>
                        <TextBox x:Name="TxtBoxRegLogin" Width="150" FontSize="18" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
                        <TextBlock Text="Пароль" Margin="0 0 10 0" FontSize="18"/>
                        <PasswordBox x:Name="TxtBoxRegPassword" Width="150" FontSize="18"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
                        <TextBlock Text="Подтвердите пароль" Margin="0 0 10 0" FontSize="18"/>
                        <PasswordBox x:Name="TxtBoxRegConfirmPassword" Width="150" FontSize="18"/>
                    </StackPanel>


                    <Button x:Name="BtnRegistr" Content="Зарегистрироваться"  Width="200" FontSize="20" Margin="0 10 0 0" HorizontalAlignment="Center" Click="BtnRegistr_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
