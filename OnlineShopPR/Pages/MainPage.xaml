<Page x:Class="OnlineShopPR.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OnlineShopPR.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage" Loaded="Page_Loaded">

    <Grid  >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Column="0">
            <TextBlock Text="⌕" FontSize="20" Margin="10 10"/>
            
             <TextBox x:Name="TxtBoxSearch" Width="200" Margin="10 10" Padding="3"/>
                
            
            <ComboBox x:Name="ComboBoxFiltr" Margin="10 0" Width="150" Height="30" SelectedIndex="0" />
            <TextBlock Text="Цена от  " Margin="0 10" />
            <TextBox x:Name="TxtBoxPriceOt" Width="40" Height="30" PreviewTextInput="TxtBoxPriceOt_PreviewTextInput"/>
            <TextBlock Text="  до  " Margin="0 10"/>
            <TextBox x:Name="TxtBoxPriceDo" Width="40" Height="30" PreviewTextInput="TxtBoxPriceOt_PreviewTextInput"/>

            <Button x:Name="BtnFind" Content="Найти" Margin="10 10 " Click="BtnFind_Click"/>
        </StackPanel>

        <Button x:Name="BtnLogin" Grid.Column="1" Content="Войти" Margin="10" Click="BtnLogin_Click"/>


        <ListBox Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}" x:Name="ListBoxGoods" Grid.ColumnSpan="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10" Width="180" Height="250">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="140"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Image Grid.Row="0" Source="{Binding PathImg}" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <Button x:Name="BtnFavorite" Content="♡"  Background="Transparent" Width="40" Height="40" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="♡"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Content" Value="❤️"/>
                                            <Setter Property="Foreground" Value="Red"/>
                                            
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>

                                
                            </Button.Style>
                            
                        </Button>

                        <TextBlock Grid.Row="1" Text="{Binding Price, StringFormat={}{0} ₽}" FontSize="18" FontWeight="Bold" Margin="0,5,0,2"/>

                        <TextBlock Grid.Row="2" Text="{Binding Name}" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Rating, StringFormat={}★ {0:0.#}}" Foreground="#FFBA00" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="{Binding ReviewCount, StringFormat={}{0} отзывов}" Margin="6,0,0,0" Foreground="#FF929292" FontSize="12"/>
                        </StackPanel>
                        <Button x:Name="BtnAddInCart" Content="В корзину" Grid.Row="4" Margin="0 10 0 5" Click="BtnAddInCart_Click"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
