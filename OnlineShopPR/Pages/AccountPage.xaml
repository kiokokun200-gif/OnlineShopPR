<Page x:Class="OnlineShopPR.Pages.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OnlineShopPR.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AccountPage">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
            
        <TextBlock Grid.Row="0" Text="{Binding Login}" FontSize="22" FontWeight="Bold" Margin="0 0 0 10"/>
        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="Текущие заказы">
                <ItemsControl d:ItemsSource="{d:SampleData ItemCount=5}" x:Name="ListCurrentOrders">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding OrderDate, StringFormat=Заказ от: {0:f}}"/>
                                    <TextBlock Text="{Binding TotalPrice, StringFormat=Сумма заказа: {0:#.##}}"/>
                                </StackPanel>

                                <Button x:Name="BtnShowOrderCurrent" Content="Посмотреть" Grid.Column="1" Margin="0 10 10 10" Click="BtnShowOrderCurrent_Click"/>
                            </Grid>
                                    
                            
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                        
                </ItemsControl>
            </TabItem>
            <TabItem Header="История заказов">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                        
                        <ComboBox x:Name="ComboBoxSortHistory" Width="200" SelectionChanged="ComboBoxSortHistory_SelectionChanged"/>
                    </StackPanel>
                    <ItemsControl Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}" x:Name="ListOrdersHistory">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding OrderDate, StringFormat=Заказ от: {0:f}}"/>
                                        <TextBlock Text="{Binding TotalPrice, StringFormat=Сумма заказа: {0:#.##}}"/>
                                    </StackPanel>

                                    <Button x:Name="BtnShowOrder" Content="Посмотреть" Grid.Column="1" Margin="0 10 10 10" Click="BtnShowOrder_Click"/>
                                </Grid>


                            </DataTemplate>
                        </ItemsControl.ItemTemplate>


                    </ItemsControl>
                </Grid>
                
            </TabItem>
            <TabItem Header="Избранное">
                <ItemsControl Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}" x:Name="ListBoxGoods" Grid.ColumnSpan="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10" Width="180" Height="250">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="140"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Image Grid.Row="0" Source="{Binding PathImg}" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <Button x:Name="BtnFavorite" Background="Transparent" Width="40" Height="40" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnFavorite_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="♡"/>
                                            <Setter Property="FontSize" Value="28"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Content" Value="❤️"/>
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>

                                </Button>

                                <TextBlock Grid.Row="1" Text="{Binding Price, StringFormat={}{0} ₽}" FontSize="18" FontWeight="Bold" Margin="0,5,0,2"/>

                                <TextBlock Grid.Row="2" Text="{Binding Name}" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>

                                <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding Rating, StringFormat={}★ {0:0.#}}" Foreground="#FFBA00" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="{Binding ReviewCount, StringFormat={}{0} отзывов}" Margin="6,0,0,0" Foreground="#FF929292" FontSize="12"/>
                                   
                                        
                                    </StackPanel>
                                <StackPanel Grid.Row="4">
                                    <Button Content="В корзину"
                                                
                                                Click="AddToCart_Click">

                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Visible"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding isInCart}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <StackPanel Orientation="Horizontal"
                                                             HorizontalAlignment="Center">

                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding isInCart}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Button Content="−"
                                                            
                                                            Click="Minus_Click"
                                                            Width="35"/>

                                        <TextBlock Text="{Binding quantityInCart}"
                                                   FontSize="18"
                                                   VerticalAlignment="Center"
                                                   Margin="15,0"/>

                                        <Button Content="+"
                                  
                                    Click="Plus_Click"
                                    Width="35"/>


                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </TabItem>
        </TabControl>
            
      
        
    </Grid>
</Page>
