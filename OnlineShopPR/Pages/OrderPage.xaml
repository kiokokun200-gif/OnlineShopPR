<Page x:Class="OnlineShopPR.Pages.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OnlineShopPR.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderPage">

    <Grid>
        <StackPanel Margin="10" >
            <TextBlock Text="Заказ" FontSize="30" FontWeight="Bold" Margin="0 0 0 10"/>

            <TextBlock Text="Итоговая цена: " FontSize="22"/>
            <TextBlock x:Name="TxtBlockTotalPrice" FontSize="22"/>
        </StackPanel>
       
        <Button x:Name="BtnConfirm"  Content="Подтвердить заказ" FontSize="22" Width="200" Height="40" HorizontalAlignment="Left" Margin="10 10 0 0" Click="BtnConfirm_Click"/> 

    </Grid>
</Page>
