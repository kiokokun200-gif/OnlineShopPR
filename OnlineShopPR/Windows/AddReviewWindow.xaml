<Window x:Class="OnlineShopPR.Windows.AddReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OnlineShopPR.Windows"
        mc:Ignorable="d"
        Title="AddReviewWindow" Height="450" Width="400">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Отзыв" FontSize="25" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Оценка: "/>
                <ComboBox x:Name="ComboBoxRating" Width="50" SelectedIndex="0"/>

            </StackPanel>
            <TextBlock Text="Текст отзыва: "/>
            <TextBox x:Name="TxtBoxTextReview" Width="370" Margin="0 0 0 10" Height="200" HorizontalContentAlignment="Stretch"/>
            <Button x:Name="BtnAddReview" Content="Оставить отзыв" Click="BtnAddReview_Click"/>

        </StackPanel>
    </Grid>
</Window>
