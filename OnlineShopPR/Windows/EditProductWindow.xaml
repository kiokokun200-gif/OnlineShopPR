<Window x:Class="OnlineShopPR.Windows.EditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OnlineShopPR.Windows"
        mc:Ignorable="d"
        Title="EditProductWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Изменение товара" Grid.ColumnSpan="2" FontSize="25" FontWeight="Bold" Margin="0 0 0 10"/>
        <TextBlock Text="Название" Grid.Column="0" Grid.Row="1" Margin="0 0 10 10"/>
        <TextBox x:Name="TxtBoxName" Text="{Binding Name}" Grid.Row="1" Grid.Column="1" Width="300" Margin="0 5 0 10" HorizontalAlignment="Left"/>

        <TextBlock Text="Описание" Grid.Column="0" Grid.Row="2" Margin="0 0 10 10"/>
        <TextBox x:Name="TxtBoxDescription" Text="{Binding Description}" Grid.Column="1" Grid.Row="2"  Width="300" Margin="0 5 0 10" HorizontalAlignment="Left"/>

        <TextBlock Text="Категория" Grid.Column="0" Grid.Row="3" Margin="0 0 10 10"/>
        <ComboBox x:Name="ComboCategory" Grid.Column="1" SelectedItem="{Binding CategoryName}"  Grid.Row="3"  Width="300" Margin="0 5 0 10" HorizontalAlignment="Left"/>

        <TextBlock Text="Цена" Grid.Column="0" Grid.Row="4" Margin="0 0 10 10"/>
        <TextBox x:Name="TxtBoxPrice" Text="{Binding Price}" Grid.Column="1" Grid.Row="4"  Width="300" Margin="0 5 0 10" HorizontalAlignment="Left"/>

        <TextBlock Text="Путь к изображению" Grid.Column="0" Grid.Row="5" Margin="0 0 10 10"/>
        <TextBox x:Name="TxtBoxPathImg" Text="{Binding PathImg}" Grid.Column="1"  Grid.Row="5"  Width="300" Margin="0 5 0 10" HorizontalAlignment="Left"/>

        <TextBlock Text="Количество на складе" Grid.Column="0" Grid.Row="6" Margin="0 0 10 10"/>
        <TextBox x:Name="TxtBoxQuantityInStock" Text="{Binding QuantityInStock }" Grid.Column="1" Grid.Row="6"  Width="300" Margin="0 5 0 10" HorizontalAlignment="Left" PreviewTextInput="TxtBoxQuantityInStock_PreviewTextInput"/>

        <TextBlock Text="Количество в упаковке" Grid.Column="0" Grid.Row="7" Margin="0 0 10 10"/>
        <TextBox x:Name="TxtBoxQuantityInPack" Text="{Binding QuantityInPack}" Grid.Column="1" Grid.Row="7"  Width="300" Margin="0 5 0 10" HorizontalAlignment="Left" PreviewTextInput="TxtBoxQuantityInStock_PreviewTextInput"/>

        <TextBlock Text="Активен" Grid.Column="0" Grid.Row="8" Margin="0 0 10 10"/>
        <CheckBox x:Name="CheckIsActive" IsChecked="{Binding isActive}" Grid.Column="1" Grid.Row="8" Margin="0 5 0 10"  HorizontalAlignment="Left"/>

        <Button x:Name="BtnEdit" Content="Изменить" Width="200" Margin="10" Grid.ColumnSpan="2" Grid.Row="9" HorizontalAlignment="Left" Click="BtnEdit_Click"/>




    </Grid>
</Window>
